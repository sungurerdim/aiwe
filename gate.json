{
  "formatVersion": 1,
  "steps": [
    { "id": "format", "command": ["gofmt", "-l", "-d", "."], "required": true, "expect": { "exitCode": 0 } },
    { "id": "lint", "command": ["custom-gcl", "run", "./..."], "required": true, "expect": { "exitCode": 0 } },
    { "id": "vuln", "command": ["go", "tool", "govulncheck", "./..."], "required": true, "expect": { "exitCode": 0 } },
    { "id": "tidy", "command": ["go", "mod", "tidy", "-diff"], "required": true, "expect": { "exitCode": 0 } },
    { "id": "deadcode", "command": ["go", "tool", "deadcode", "./cmd/..."], "required": true,
      "expect": { "exitCode": 0, "outputRejects": "\\S" } },
    { "id": "repo", "command": ["go", "run", "./internal/cmd/repocheck", "all"], "required": true, "expect": { "exitCode": 0 } },
    { "id": "test", "command": ["go", "test", "./..."], "required": true, "expect": { "exitCode": 0 } }
  ]
}
